<%- include('partials/layout-top', { usuario, activo: 'portafolio' }) %>

  <h1><%= item ? 'Editar elemento de portafolio' : 'Nuevo elemento de portafolio' %></h1>

  <form class="admin-form" method="POST" action="<%= item ? '/admin/portafolio/' + item.id + '/editar' : '/admin/portafolio/nuevo' %>">

    <label for="marca_id">Marca</label>
    <select id="marca_id" name="marca_id" required <%= item ? 'disabled' : '' %>>
      <% marcas.forEach(function(m) { %>
        <option value="<%= m.id %>" <%= item && item.marca_id === m.id ? 'selected' : '' %>>
          <%= m.nombre %>
        </option>
      <% }); %>
    </select>
    <% if (item) { %>
      <input type="hidden" name="marca_id" value="<%= item.marca_id %>">
      <p style="font-size:12px; color:#888; margin-top:-12px;">La marca no se puede cambiar al editar — crea un nuevo elemento si necesitas moverlo a otra marca.</p>
    <% } %>

    <label for="titulo">Título</label>
    <input type="text" id="titulo" name="titulo" value="<%= item ? (item.titulo || '') : '' %>">

    <label for="descripcion">Descripción</label>
    <textarea id="descripcion" name="descripcion" rows="2"><%= item ? (item.descripcion || '') : '' %></textarea>

    <label for="orden">Orden de aparición</label>
    <input type="number" id="orden" name="orden" value="<%= item ? item.orden : '0' %>">

    <label for="iframe_embed">Código embed (iframe)</label>
    <textarea id="iframe_embed" name="iframe_embed" rows="10" required><%= item ? item.iframe_embed : '' %></textarea>

    <button type="submit"><%= item ? 'Guardar cambios' : 'Crear elemento' %></button>
    <a href="/admin/portafolio" style="margin-left:12px;">Cancelar</a>
  </form>

<%- include('partials/layout-bottom') %>